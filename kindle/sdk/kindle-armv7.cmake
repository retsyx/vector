set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7)
set(CMAKE_C_COMPILER "${CMAKE_CURRENT_LIST_DIR}/arm-cc")
set(CMAKE_CXX_COMPILER "${CMAKE_CURRENT_LIST_DIR}/arm-cxx")
set(CMAKE_AR "${CMAKE_CURRENT_LIST_DIR}/arm-ar")
set(CMAKE_RANLIB "${CMAKE_CURRENT_LIST_DIR}/arm-ranlib")

set(CMAKE_FIND_ROOT_PATH "${CMAKE_CURRENT_LIST_DIR}/sysroot")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_SKIP_RPATH ON CACHE BOOL "Exclude host library paths from Kindle binaries")

set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_CURRENT_LIST_DIR}/sysroot")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_CURRENT_LIST_DIR}/sysroot/usr/lib/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "")
