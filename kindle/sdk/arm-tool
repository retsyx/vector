#!/bin/sh
set -eu

sdk_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
case "${0##*/}" in
    arm-cc) tool=cc ;;
    arm-cxx) tool=c++ ;;
    arm-ar) tool=ar ;;
    arm-ranlib) tool=ranlib ;;
    *) echo "Invoke this driver as arm-cc, arm-cxx, arm-ar, or arm-ranlib." >&2; exit 2 ;;
esac

case "$tool" in
    cc|c++) set -- -target arm-linux-musleabihf -mcpu=cortex_a7 "$@" ;;
esac
exec "$sdk_dir/zig-aarch64-macos-0.16.0/zig" "$tool" "$@"
